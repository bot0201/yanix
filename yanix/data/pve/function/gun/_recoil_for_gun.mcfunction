# 后座力计算 + 应用宏 (gun:_recoil_for_gun)
# 参数:
#   base_steps - 基准后座力步数 (M4A1:5, AWM:2, M2:8)
#   angle      - 每步旋转角度 (M4A1/AWM:-0.1, M2:-0.05)
#   scope1/2/3 - 瞄准镜配件影响值 (可为负数/0, 负数=减少后座)
#   muzzle2    - 消音器配件影响值
#   grip1/2    - 握把配件影响值
$scoreboard players set #recoil db $(base_steps)
$execute if score @s attach_scope = #scope_tier_1 const run scoreboard players add #recoil db $(scope1)
$execute if score @s attach_scope = #scope_tier_2 const run scoreboard players add #recoil db $(scope2)
$execute if score @s attach_scope = #scope_tier_3 const run scoreboard players add #recoil db $(scope3)
$execute if score @s attach_muzzle = #muzzle_tier_2 const run scoreboard players add #recoil db $(muzzle2)
$execute if score @s attach_grip = #grip_tier_1 const run scoreboard players add #recoil db $(grip1)
$execute if score @s attach_grip = #grip_tier_2 const run scoreboard players add #recoil db $(grip2)
$execute if score #recoil db matches 1.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 2.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 3.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 4.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 5.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 6.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 7.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 8.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 9.. run rotate @s ~ ~$(angle)
$execute if score #recoil db matches 10.. run rotate @s ~ ~$(angle)