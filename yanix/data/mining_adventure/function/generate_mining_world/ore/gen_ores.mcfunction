#    煤炭 Y 不限 | 铁 Y<-35 | 金 Y<-45 | 钻石 Y<-50
# ============================================================

# ---- 初始种子计数 ----
scoreboard players set #ma_ore_count MA_ORE_TYPE 25

# ---- 开始递归播种 ----
function mining_adventure:generate_mining_world/ore/gen_ore_seed